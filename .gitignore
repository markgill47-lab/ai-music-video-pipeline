# Intermediate working folders from assembly and upscaling
projects/*/out/edit/
projects/*/out/edit_full/
projects/*/out/upscale_full/

# One-off housekeeping
_reorganize.py
_reorganize.log
_release/

# Life in 2045: the full album and synopsis stay local; each video commits only its own song
projects/life_in_2045/album/
projects/**/out/edit/
projects/**/out/upscale/

# Chamber promo: personal footage and a named presenter; stays local
projects/chamber_promo/

