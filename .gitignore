*.pyc

# Local Claude Code settings (skills under .claude/skills/ ARE committed)
.claude/settings.local.json

# Earlier experiments, kept locally only
projects/earlier_tests/

# Rendered video is published as GitHub Release assets, not committed
*.mp4
*.mov
